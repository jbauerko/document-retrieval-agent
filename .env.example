# The only required setting for the default Gemini setup.
GEMINI_API_KEY=

# Optional: these defaults are already built in. Use the endpoint's model name,
# without a LiteLLM provider prefix.
# DOCUMENT_RETRIEVAL_AGENT_MODEL=gemini-3.5-flash-lite
# DOCUMENT_RETRIEVAL_AGENT_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai

# To use another OpenAI-compatible provider, set its base URL, model, and key.
# DOCUMENT_RETRIEVAL_AGENT_API_KEY=
